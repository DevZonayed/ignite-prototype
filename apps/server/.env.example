# IGNITE Server Environment Variables
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ignite

# JWT
JWT_SECRET=ignite-dev-secret-change-in-production
JWT_EXPIRATION=7d

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
