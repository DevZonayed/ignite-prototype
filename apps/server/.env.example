# IGNITE Server Environment Variables
NODE_ENV=development
PORT=4000

# Database
# DB_TYPE=sqlite (default) uses sql.js — an in-process SQLite file, no server
# needed, schema built by synchronize. Good for local work, no migration story.
# DB_TYPE=postgres is what deployments use: synchronize is off and pending
# migrations run at boot (see src/config/database.config.ts).
DB_TYPE=sqlite
DB_SQLITE_PATH=./ignite.sqlite

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ignite
# true when the provider terminates TLS with a certificate we do not pin
# (most managed Postgres). Leave unset for a database on the same private network.
# DB_SSL=false

# Host port for the local Postgres container in docker-compose.yml. Change it
# when a Postgres already installed on the machine holds 5432 — it binds
# 127.0.0.1 and silently shadows the container.
# IGNITE_DB_PORT=5432

# JWT — generate a fresh one per environment: openssl rand -base64 48
JWT_SECRET=ignite-dev-secret-change-in-production
JWT_EXPIRATION=7d

# Demo data. Leave on locally for a populated platform; set false for any real
# deployment so the database starts empty and the admin portal shows its
# first-run screen to create the initial platform administrator.
SEED_DEMO_DATA=true
# Password shared by every seeded account. Set this whenever SEED_DEMO_DATA is
# on outside your own machine — the fallback is a well-known literal.
# SEED_DEFAULT_PASSWORD=change-me

# Browser origins allowed to call the API. Defaults to '*', which is fine for
# local work but should be the real portal origins in a deployment.
# CORS_ORIGIN=https://admin.ignite.edu.ng,https://school.ignite.edu.ng

# Where invite emails send people to activate their account. Administrators are
# linked to the admin portal, everyone else to the school portal. Point these at
# real domains in a deployment — the defaults are the local dev servers.
ADMIN_PORTAL_URL=http://localhost:5173
SCHOOL_PORTAL_URL=http://localhost:5174

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Outgoing email (password-reset OTP).
# Leave SMTP_HOST unset in development: codes are written to the server log and
# returned as `devCode` from POST /api/auth/forgot-password instead of being sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for implicit TLS (port 465)
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# MAIL_FROM=IGNITE <no-reply@ignite.edu.ng>

# Echo the OTP in the API response when SMTP is unconfigured. Never enabled in
# production regardless of this value.
AUTH_OTP_DEV_ECHO=true
