# IGNITE Server Environment Variables
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ignite

# JWT
JWT_SECRET=ignite-dev-secret-change-in-production
JWT_EXPIRATION=7d

# Where invite emails send people to activate their account. Administrators are
# linked to the admin portal, everyone else to the school portal. Point these at
# real domains in a deployment — the defaults are the local dev servers.
ADMIN_PORTAL_URL=http://localhost:5173
SCHOOL_PORTAL_URL=http://localhost:5174

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Outgoing email (password-reset OTP).
# Leave SMTP_HOST unset in development: codes are written to the server log and
# returned as `devCode` from POST /api/auth/forgot-password instead of being sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for implicit TLS (port 465)
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# MAIL_FROM=IGNITE <no-reply@ignite.edu.ng>

# Echo the OTP in the API response when SMTP is unconfigured. Never enabled in
# production regardless of this value.
AUTH_OTP_DEV_ECHO=true
